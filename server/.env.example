# Copy to server/.env and change every secret before production.
NODE_ENV=development
HOST=127.0.0.1
API_PORT=3000
VERSION_LABEL=dev

JWT_SECRET=dev-only-jwt-secret-change-me-in-production-0123456789
JWT_TTL_SECONDS=604800

INVITE_CODE=
LAUNCH_TOKEN_TTL_SECONDS=120

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=esf_platform
DB_USER=esf_app
DB_PASSWORD=esf_dev_app_pw

DB_ROOT_USER=root
DB_ROOT_PASSWORD=

AMXX_DB_USER=esf_amxx
AMXX_DB_PASSWORD=esf_dev_amxx_pw
AMXX_ALLOWED_HOST=127.0.0.1

# Developer MySQL named pipe (omit in production)
DB_ROOT_SOCKET=ESFDevMySQL
DB_ALLOWED_HOST=127.0.0.1

# Launcher update feed
LATEST_VERSION=0.1.0
RELEASE_NOTES=
UPDATE_FEED_URL=
DOWNLOAD_URL=

# One-time upload token for POST /api/admin/update-upload
UPDATE_UPLOAD_TOKEN=change-me
UPDATE_DIR=updates
