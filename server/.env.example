# 本地开发配置（已 gitignore，不要提交）
NODE_ENV=development
HOST=127.0.0.1
API_PORT=3000
VERSION_LABEL=dev

JWT_SECRET=dev-only-jwt-secret-change-me-in-production-0123456789
JWT_TTL_SECONDS=604800

INVITE_CODE=

LAUNCH_TOKEN_TTL_SECONDS=120

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=esf_platform
DB_USER=esf_app
DB_PASSWORD=esf_dev_app_pw

DB_ROOT_USER=root
DB_ROOT_PASSWORD=

AMXX_DB_USER=esf_amxx
AMXX_DB_PASSWORD=esf_dev_amxx_pw
AMXX_ALLOWED_HOST=127.0.0.1

# 开发实例的 root 走命名管道（生产环境删除这两行，改用 TCP + 密码）
DB_ROOT_SOCKET=ESFDevMySQL
DB_ALLOWED_HOST=127.0.0.1

# 版本更新（启动器「检查更新」会拿 LATEST_VERSION 和自身版本比）
LATEST_VERSION=0.1.0
RELEASE_NOTES=
# 自动更新源（electron-updater 的 generic 目录，指向放 latest.yml 的地址）
UPDATE_FEED_URL=
DOWNLOAD_URL=
