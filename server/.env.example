# ESF Platform 后端环境变量模板
# 复制为 server/.env 后逐项填写。本文件在公开仓库中，禁止写入任何真实口令或令牌。
# 所有 CHANGE_ME 与留空的密钥项在生产都必须替换；启动会校验 JWT_SECRET 至少 16 字符。
# 注释请单独占一行，不要写在值后面（dotenv 对行内注释的处理因版本而异）。

# ---- 运行 ----
NODE_ENV=production
HOST=127.0.0.1
API_PORT=3000
VERSION_LABEL=prod

# ---- 鉴权与账号安全 ----
JWT_SECRET=CHANGE_ME_at_least_16_random_chars
JWT_TTL_SECONDS=604800
BCRYPT_ROUNDS=10
# 小范围邀请制：生产必须设置，否则注册接口没有门槛（启动时仅告警，不阻断）
INVITE_CODE=CHANGE_ME
LOGIN_MAX_FAILURES=10
LOGIN_LOCK_MINUTES=15
LAUNCH_TOKEN_TTL_SECONDS=120
RESET_CODE_TTL_MINUTES=15

# ---- 邮件（QQ SMTP，仅用于绑定邮箱 / 找回密码）----
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- 公告与版本下发 ----
NOTICE=
MAINTENANCE=0
MIN_LAUNCHER_VERSION=0.0.0
LATEST_VERSION=0.6.1
RELEASE_NOTES=
UPDATE_FEED_URL=https://119.29.82.217/updates/
DOWNLOAD_URL=https://github.com/xiaolouxi123/esf-platform/releases/download/v0.6.1/ESF-Platform-Setup-0.6.1.exe

# ---- 资源库与更新源目录 ----
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=64
UPDATE_DIR=updates
# 上传安装包用的一次性令牌
UPDATE_UPLOAD_TOKEN=CHANGE_ME
# 114 运维 agent 的 key，等价于该机管理员权限
OPS_AGENT_KEY=CHANGE_ME

# ---- 数据库（生产为 3306；本机 dev 库改 3307，见 scripts/dev-db.cjs）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=esf_platform
DB_USER=esf_app
DB_PASSWORD=CHANGE_ME
DB_ALLOWED_HOST=127.0.0.1

# ---- AMXX 插件数据库账号与构建心跳期望 ----
AMXX_DB_USER=esf_amxx
AMXX_DB_PASSWORD=CHANGE_ME
AMXX_ALLOWED_HOST=114.132.84.150
# 与插件 BUILD 常量一致；发布新插件包时同步修改（见 KB pattern/release-amxx）
AMXX_EXPECTED_PLATFORM_AUTH=0.53
AMXX_EXPECTED_RANKED_LOCK=0.53
AMXX_EXPECTED_TEST_RANKED=0.53
AMXX_EXPECTED_GAMEMODE=1.0.0
AMXX_HEARTBEAT_STALE_SECONDS=900

# ---- 仅运维脚本读取，应用本身不读 ----
DB_ROOT_USER=root
DB_ROOT_PASSWORD=CHANGE_ME
# 本机 dev 库走命名管道；生产留空，用 TCP + 密码
DB_ROOT_SOCKET=
MYSQL_BASE=C:\Program Files\MySQL\MySQL Server 8.0
MYSQL_BIN=
DEV_DB_PORT=3307
DEV_DB_PIPE=ESFDevMySQL
API_BASE=http://127.0.0.1:3000
ESF_API=
